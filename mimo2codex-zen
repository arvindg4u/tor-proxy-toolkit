#!/bin/bash
# Single mimo2codex instance on :8788 (Codex CLI -> Kilo gateway).
# Upstream goes through the smart-proxy (:18090), which routes via the WG
# tunnel when healthy and falls back to direct automatically when the
# tunnel is down — scoped to this process only, nothing global, no system
# exports. Starts regardless of tunnel state (failover is automatic).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
STUDIO="$(cd "$SCRIPT_DIR/.." && pwd)"
PID_DIR="/tmp/tor-toolkit-pids"
LOG_DIR="${HOME}/.claude/zen-logs"
PIDFILE="$PID_DIR/mimo2codex.pid"
LOGFILE="$LOG_DIR/mimo2codex-8788.log"

# Portable binary lookup: repo-local install first, then PATH.
find_bin() {
    for c in "$STUDIO/tools/node_modules/.bin/mimo2codex" \
             "$HOME/tools/node_modules/.bin/mimo2codex"; do
        [ -x "$c" ] && { echo "$c"; return 0; }
    done
    command -v mimo2codex 2>/dev/null
}

do_start() {
    BIN="$(find_bin)"
    [ -n "$BIN" ] || { echo "[✗] mimo2codex binary not found (expected $STUDIO/tools/node_modules/.bin/mimo2codex)"; return 1; }
    # Smart-proxy upstream (process-scoped). NO_PROXY covers only localhost,
    # so local :8788 stays direct while api.kilo.ai goes via :18090, which
    # itself routes tunnel-when-healthy else direct — fully automatic.
    export HTTP_PROXY="http://127.0.0.1:18090" HTTPS_PROXY="http://127.0.0.1:18090"
    export http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY"
    export NO_PROXY="127.0.0.1,localhost" no_proxy="127.0.0.1,localhost"
    mkdir -p "$LOG_DIR" "$PID_DIR"
    "$BIN" --model generic > "$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 8
    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null \
       && curl -s --max-time 5 -o /dev/null http://127.0.0.1:8788/v1/models; then
        echo "[✓] mimo2codex started (PID: $(cat "$PIDFILE")) via smart-proxy 127.0.0.1:18090"
        return 0
    fi
    echo "[✗] Failed to start — check $LOGFILE"
    tail -5 "$LOGFILE" 2>/dev/null
    return 1
}

do_stop() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    pkill -f "mimo2codex --model generic" 2>/dev/null || true
    echo "[✓] mimo2codex stopped (:8788)"
}

case "${1:-status}" in
    restart)
        # No tunnel gate: smart-proxy (:18090) fails over to direct
        # automatically, so restart is always safe.
        do_stop >/dev/null 2>&1
        sleep 1
        do_start
        ;;
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "[✓] mimo2codex is running (PID: $(cat "$PIDFILE"))"
            curl -s --max-time 5 http://127.0.0.1:8788/v1/models | head -c 200
            echo ""
        else
            echo "[✗] mimo2codex is not running"
        fi
        ;;
    *)
        echo "Usage: mimo2codex-zen {start|stop|restart|status}"
        echo "  :8788 Codex CLI -> Kilo gateway, upstream via smart-proxy :18090 (tunnel when healthy, direct fallback)"
        ;;
esac
