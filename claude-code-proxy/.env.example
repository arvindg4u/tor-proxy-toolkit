# Claude Code Proxy — copy to .env and fill in (never commit .env)
# Backend: OpenCode ZEN (https://opencode.ai/zen/v1)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://opencode.ai/zen/v1
BIG_MODEL=muse-spark-1.3-contributor-free
MIDDLE_MODEL=muse-spark-1.3-contributor-free
SMALL_MODEL=muse-spark-1.3-contributor-free
# Upstream wire API: chat (/chat/completions) or responses (/responses).
# Muse Spark on ZEN is responses-only.
UPSTREAM_WIRE_API=responses
UPSTREAM_USER_AGENT=opencode/1.18.18
RESPONSES_MIN_OUTPUT_TOKENS=2048
# Retry budget (seconds) for retryable upstream 5xx with backoff.
RESPONSES_RETRY_BUDGET_SECS=120
# Leave unset to disable client key validation (any key accepted)
# ANTHROPIC_API_KEY=
HOST=127.0.0.1
PORT=4013
LOG_LEVEL=INFO
MAX_TOKENS_LIMIT=128000
MIN_TOKENS_LIMIT=100
REQUEST_TIMEOUT=180
MAX_RETRIES=2
# Stream keepalive (seconds) — SSE pings during silent reasoning phases.
# 0 disables.
STREAM_KEEPALIVE_SECS=15
