# ─────────────── mimo2codex provider config ───────────────
# opencode.ai → DeepSeek V4 Flash Free (default working setup)
GENERIC_BASE_URL=https://opencode.ai/zen/v1
GENERIC_API_KEY=sk-you-api-key-here
GENERIC_DEFAULT_MODEL=deepseek-v4-flash-free
GENERIC_SHORTCUT=deepseek
GENERIC_DISPLAY_NAME=DeepSeek V4 Flash Free (OpenCode)

# ─────────────── Runtime Config ───────────────
MIMO2CODEX_DEFAULT_PROVIDER=generic
MIMO2CODEX_PORT=8788
MIMO2CODEX_HOST=127.0.0.1

# ─────────────── Upstream identity (REQUIRED) ───────────────
# opencode.ai/zen rate-limits by User-Agent: only opencode client UAs get the
# normal free tier. Anything else (mimo2codex/…, curl, python-requests) is
# treated as a bot and 429s (FreeUsageLimitError) after a few turns — even from
# a fresh IP. Sending the real CLI UA keeps the proxy on the trusted tier.
# Requires the config.js patch (run `bash mimo2codex/patch-user-agent.sh`).
MIMO2CODEX_UPSTREAM_USER_AGENT=opencode/1.18.18
