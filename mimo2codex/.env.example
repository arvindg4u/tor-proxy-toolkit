# ─────────────── mimo2codex provider config ───────────────
# opencode.ai → Muse Spark 1.3 Free (current default working setup).
# List models: curl https://opencode.ai/zen/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
GENERIC_BASE_URL=https://opencode.ai/zen/v1
GENERIC_API_KEY=sk-you-api-key-here
GENERIC_DEFAULT_MODEL=muse-spark-1.3-contributor-free
GENERIC_SHORTCUT=muse
GENERIC_DISPLAY_NAME=Muse Spark 1.3 Free (OpenCode)
GENERIC_WIRE_API=responses


# ─────────────── Alternative provider: NVIDIA NIM ───────────────
# Uncomment to use NVIDIA instead:
# GENERIC_BASE_URL=https://integrate.api.nvidia.com/v1
# GENERIC_API_KEY=nvapi-you-api-key-here
# GENERIC_DEFAULT_MODEL=moonshotai/kimi-k3

# ─────────────── Alternative provider: Kilo AI gateway ───────────────
# Unified OpenAI-compatible endpoint; switch models with one string.
# List models: curl https://api.kilo.ai/api/gateway/models
# Free models (e.g. deepseek-*-free) also work anonymously (no key, rate
# limits apply) — but set a key for paid models / higher limits.
# Uncomment to use Kilo instead:
# GENERIC_BASE_URL=https://api.kilo.ai/api/gateway
# GENERIC_API_KEY=your-kilo-api-key-here
# GENERIC_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731:free
# GENERIC_SHORTCUT=kilo
# GENERIC_DISPLAY_NAME=DeepSeek V4 Flash (Kilo gateway)
# GENERIC_WIRE_API=chat
#   ^ This is the UPSTREAM (Kilo) wire API, not Codex's. Kilo is chat-only, so
#   the proxy translates: Codex sends Responses -> mimo2codex -> /chat/completions
#   upstream (see dist/translate/reqToChat.js, respToResponses.js). Leave the
#   [model_providers.kilo-proxy] block at wire_api = "responses" — Codex removed
#   chat support in Feb 2026 and will refuse to start on wire_api = "chat".

# ─────────────── Runtime Config ───────────────
MIMO2CODEX_DEFAULT_PROVIDER=generic
MIMO2CODEX_PORT=8788
MIMO2CODEX_HOST=127.0.0.1

# ─────────────── Upstream identity (only needed for OpenCode ZEN) ───────────────
# zen rate-limits by User-Agent: only opencode client UAs get the normal free
# tier; anything else is treated as a bot and 429s after a few turns. Sending
# the real CLI UA keeps the proxy on the trusted tier.
# Requires the config.js patch (`bash mimo2codex/patch-user-agent.sh`).
# Harmless with NVIDIA — leave it set.
MIMO2CODEX_UPSTREAM_USER_AGENT=opencode/1.18.18