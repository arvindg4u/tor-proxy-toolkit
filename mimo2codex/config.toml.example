# Codex CLI config — points to local mimo2codex proxy
# Copy to ~/.codex/config.toml

#:schema https://developers.openai.com/codex/config-schema.json

model = "x-preview-f-free"
model_provider = "zen-proxy"
model_reasoning_effort = "max"
model_context_window = 1000000
model_max_output = 128000
service_tier = "default"

# Model metadata catalog so Codex trusts the 1M context window
# (without it, Codex falls back to ~258K and compacts too early).
# Copy catalog.json next to this config: cp mimo2codex/catalog.json ~/.codex/catalog.json
model_catalog_json = "~/.codex/catalog.json"

approval_policy = "never"
approvals_reviewer = "user"
sandbox_mode = "danger-full-access"

web_search = "live"

[notice]
hide_full_access_warning = true

[model_providers.zen-proxy]
name = "OpenCode ZEN (via mimo2codex proxy)"
base_url = "http://127.0.0.1:8788/v1"
env_key = "OPENAI_API_KEY"
wire_api = "responses"
requires_openai_auth = false
supports_websockets = false
stream_idle_timeout_ms = 600000

# NOTE: per-model metadata lives in catalog.json (via model_catalog_json above),
# not in a [model_properties.*] table. Codex 0.146+ ignores the latter.

[features]
terminal_resize_reflow = true
memories = true
goals = true
prevent_idle_sleep = true
network_proxy = true
multi_agent = true

[profiles.strict]
approval_policy = "on-request"
sandbox_mode = "read-only"
web_search = "cached"

[profiles.yolo]
approval_policy = "never"
sandbox_mode = "workspace-write"
web_search = "live"

[agents]
max_threads = 6
max_depth = 1
