# ============================================
# Tor Proxy Toolkit — claude-zen (Claude Code Proxy) config template
# Copy to .env and fill in the secrets (NEVER commit .env).
#   cp .env.example .env
# Backend: OpenCode ZEN (free tier) via responses wire API.
# Requires the WG tunnel up first: ../wgtunnel/wireproxy/manage.sh start <peer>
# ============================================

# === Upstream (OpenCode ZEN) ===
# API key for opencode.ai/zen/v1. Free-tier "public" key works from genuine
# CLI-shaped traffic (which this proxy produces); otherwise put a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/v1
BIG_MODEL=muse-spark-1.3-contributor-free
MIDDLE_MODEL=muse-spark-1.3-contributor-free
SMALL_MODEL=muse-spark-1.3-contributor-free
# muse-spark on ZEN is responses-only upstream (500s on chat/completions)
UPSTREAM_WIRE_API=responses
UPSTREAM_USER_AGENT=opencode/1.18.31
RESPONSES_MIN_OUTPUT_TOKENS=2048
RESPONSES_RETRY_BUDGET_SECS=120
STREAM_KEEPALIVE_SECS=15

# === CLI identity (free-tier gate) ===
# Session MUST be a genuine CLI-generated ses_ id (values are reusable and
# do not expire). Grab one from a local opencode session, e.g.:
#   sqlite3 ~/.local/share/opencode/opencode.db \
#     "select id from session order by time_created desc limit 1"
OPENCODE_SESSION_ID=
OPENCODE_PROJECT_ID=global
OPENCODE_CLIENT=cli
# Leave empty: the proxy mints a fresh msg_ id per request automatically.
OPENCODE_USER_ID=

# === Proxy listener ===
CLAUDE_PROXY_PORT=4013
