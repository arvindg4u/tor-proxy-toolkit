# ============================================
# Tor Proxy Toolkit — Environment Variables (claude-zen + mimo + tor)
# Copy to .env and fill in your values (NEVER commit .env):
#   cp .env.example .env
# Requires the WG tunnel up first: ../wgtunnel/wireproxy/manage.sh start <peer>
# ============================================

# === Tor Control (only needed for start.sh full stack) ===
TOR_CONTROL_PASSWORD=chintu_tor_2026
TOR_CONTROL_PORT=9051
TOR_SOCKS_PORT1=9050
TOR_SOCKS_PORT2=9060

# === Claude Code Proxy (port 4013) ===
# Backend: OpenCode ZEN (free tier) via responses wire API.
CLAUDE_PROXY_PORT=4013
# Free-tier "public" key works from genuine CLI-shaped traffic (which this
# proxy produces); otherwise put a real key. No upstream key needed for
# local boot/health (upstream calls need a real key).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/v1
BIG_MODEL=muse-spark-1.3-contributor-free
MIDDLE_MODEL=muse-spark-1.3-contributor-free
SMALL_MODEL=muse-spark-1.3-contributor-free
ANTHROPIC_API_KEY=
# Upstream wire API: chat (/chat/completions) or responses (/responses).
# Responses-only models (e.g. Muse Spark on ZEN) need responses.
UPSTREAM_WIRE_API=responses
UPSTREAM_USER_AGENT=opencode/1.18.31
RESPONSES_MIN_OUTPUT_TOKENS=2048
RESPONSES_RETRY_BUDGET_SECS=120
STREAM_KEEPALIVE_SECS=15
# HTTP2 upstream: 1 force on, 0 force off, unset = auto-detect (needs h2).
# HTTP2=
# Directory for last_upstream_failure.json (watched by watch-429.sh).
# PROXY_LOG_DIR=logs

# === CLI identity (free-tier gate) ===
# Session MUST be a genuine CLI-generated ses_ id (values are reusable and
# do not expire). Grab one from a local opencode session, e.g.:
#   sqlite3 ~/.local/share/opencode/opencode.db \
#     "select id from session order by time_created desc limit 1"
OPENCODE_SESSION_ID=
OPENCODE_PROJECT_ID=global
OPENCODE_CLIENT=cli
# Leave empty: the proxy mints a fresh msg_ id per request automatically.
OPENCODE_USER_ID=

# === Codex / OpenCode Proxy (port 8788) ===
# MiMo proxy for Codex CLI
MIMO_PROXY_PORT=8788
MIMO_API_KEY=

# === IP Rotation ===
ROTATE_INTERVAL=600  # seconds (10 minutes)
