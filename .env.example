# ============================================
# Tor Proxy Toolkit — Environment Variables
# Copy this to .env and fill in your values
# ============================================

# === Tor Control ===
TOR_CONTROL_PASSWORD=chintu_tor_2026
TOR_CONTROL_PORT=9051
TOR_SOCKS_PORT1=9050
TOR_SOCKS_PORT2=9060

# === Claude Code Proxy (port 4013) ===
# Backend: opencode.ai/zen endpoint
CLAUDE_PROXY_PORT=4013
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://opencode.ai/zen/v1
BIG_MODEL=x-preview-f-free
SMALL_MODEL=x-preview-f-free
ANTHROPIC_API_KEY=sk-your-anthropic-key-here
# Upstream wire API: chat (/chat/completions) or responses (/responses).
# Responses-only models (e.g. Muse Spark on ZEN) need responses.
UPSTREAM_WIRE_API=chat
UPSTREAM_USER_AGENT=opencode/1.18.18
RESPONSES_MIN_OUTPUT_TOKENS=2048
STREAM_KEEPALIVE_SECS=15

# === Codex / OpenCode Proxy (port 8788) ===
# MiMo proxy for Codex CLI
MIMO_PROXY_PORT=8788
MIMO_API_KEY=sk-your-mimo-api-key-here

# === IP Rotation ===
ROTATE_INTERVAL=600  # seconds (10 minutes)
